# Which environment this container is. Names the Parameter Store path every
# other setting is read from (/<env>/s3_bucket, /<env>/log_level, ...) and the
# CloudWatch log group (/<env>/serdsafely/backend). Required — the container
# exits without it rather than guessing.
SERDSAFE_PLATFORM_ENV=dev

# Needed before Parameter Store can be reached, so it cannot come from it.
AWS_REGION=us-east-1

# Points every AWS call — Parameter Store, S3 and CloudWatch alike — at an
# emulator instead of AWS. Either the endpoint itself, or "true" to mean
# http://localhost:4566. Leave unset for real AWS.
# From inside a container, an emulator on your machine is not "localhost"
# (that is the container); reach it at host.docker.internal.
# SERDSAFE_LOCAL_STACK=http://host.docker.internal:4566

# --- Everything below normally comes from Parameter Store ------------------
# These are the values left in force when a parameter is absent. In a
# deployment they live at /<env>/<name>, not here.
#
# S3_BUCKET=
# Key prefix. A missing trailing slash is added for you, and "/" means the
# bucket root — which is the only way to say that through Parameter Store,
# since it cannot hold an empty value.
# S3_PREFIX=uploads/
# NEGATIVE_CACHE_SECONDS=15
# MAX_UPLOAD_BYTES=536870912
#
# LOG_LEVEL is one of CRITICAL, ERROR, WARNING, INFO, DEBUG; DEBUG=true
# overrides it. Both can be re-read on a running container via POST /api/logging.
# LOG_LEVEL=INFO
# DEBUG=false
#
# CLOUDWATCH_LOGS_ENABLED=true
# Leave the group unset to derive /<env>/serdsafely/backend from the
# environment name; set it only to break that convention deliberately.
# CLOUDWATCH_LOG_GROUP=
# Defaults to the container host name, keeping concurrent tasks in separate streams.
# CLOUDWATCH_LOG_STREAM=

# Credentials: use a task role in AWS. Locally, prefer ~/.aws or AWS_PROFILE
# over putting long-lived keys in this file.
# AWS_PROFILE=
