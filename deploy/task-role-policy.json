{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentConfig",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": "arn:aws:ssm:us-east-2:713829883394:parameter/prod"
    },
    {
      "Sid": "ListOnlyTheServedPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::file-repo",
      "Condition": {
        "StringLike": {
          "s3:prefix": "uploads/*"
        }
      }
    },
    {
      "Sid": "ReadObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::file-repo/uploads/*"
    }
  ]
}
